# Base URL of the Go backend (main.go listens on :8080 by default)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Render the built-in Paris fixture instead of calling the API.
# Useful for working on the UI before the Pinecone index is seeded.
# Anything shown this way is labelled as sample data.
NEXT_PUBLIC_DEMO_MODE=false
